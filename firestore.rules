rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    // Helper function to check if user is staff
    function isStaff() {
      return getUserRole() == 'staff';
    }
    
    // Helper function to check if user is technician
    function isTechnician() {
      return getUserRole() == 'technician';
    }
    
    // Helper function to check if user is complainer
    function isComplainer() {
      return getUserRole() == 'complainer';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && isOwner(userId);
      
      // Admins can read all users
      allow read: if request.auth != null && isAdmin();
      
      // Users can update their own profile (except role)
      allow write: if request.auth != null 
                    && isOwner(userId)
                    && request.resource.data.role == resource.data.role;
      
      // Admins can create and update any user
      allow write: if request.auth != null && isAdmin();
    }
    
    // Tickets collection
    match /tickets/{ticketId} {
      // Complainers can read their own tickets
      allow read: if request.auth != null 
                  && resource.data.createdById == request.auth.uid;
      
      // Technicians can read tickets assigned to them
      allow read: if request.auth != null 
                  && resource.data.assignedToId == request.auth.uid;
      
      // Staff and admins can read all tickets
      allow read: if request.auth != null && (isStaff() || isAdmin());
      
      // Complainers can create tickets
      allow create: if request.auth != null 
                    && isComplainer()
                    && request.resource.data.createdById == request.auth.uid;
      
      // Technicians can update tickets assigned to them
      allow update: if request.auth != null 
                    && isTechnician()
                    && resource.data.assignedToId == request.auth.uid;
      
      // Staff and admins can update any ticket
      allow update: if request.auth != null && (isStaff() || isAdmin());
      
      // Only admins can delete tickets
      allow delete: if request.auth != null && isAdmin();
    }
    
    // Messages collection
    match /messages/{messageId} {
      // Users can read messages if they are the author
      allow read: if request.auth != null 
                  && resource.data.authorId == request.auth.uid;
      
      // Users can read messages if they are the ticket creator
      allow read: if request.auth != null 
                  && get(/databases/$(database)/documents/tickets/$(resource.data.ticketId)).data.createdById == request.auth.uid;
      
      // Technicians can read messages for tickets assigned to them
      allow read: if request.auth != null 
                  && isTechnician()
                  && get(/databases/$(database)/documents/tickets/$(resource.data.ticketId)).data.assignedToId == request.auth.uid;
      
      // Staff and admins can read all messages
      allow read: if request.auth != null && (isStaff() || isAdmin());
      
      // Authenticated users can create messages for tickets they have access to
      allow create: if request.auth != null 
                    && request.resource.data.authorId == request.auth.uid
                    && (
                      // Complainer creating message for their own ticket
                      (isComplainer() && get(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId)).data.createdById == request.auth.uid) ||
                      // Technician creating message for assigned ticket
                      (isTechnician() && get(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId)).data.assignedToId == request.auth.uid) ||
                      // Staff and admin can create messages for any ticket
                      isStaff() || isAdmin()
                    );
      
      // Only message author can update their own messages
      allow update: if request.auth != null 
                    && resource.data.authorId == request.auth.uid;
      
      // Only admins can delete messages
      allow delete: if request.auth != null && isAdmin();
    }
    
    // Shifts collection
    match /shifts/{shiftId} {
      // Technicians can read their own shifts
      allow read: if request.auth != null 
                  && resource.data.technicianId == request.auth.uid;
      
      // Staff and admins can read all shifts
      allow read: if request.auth != null && (isStaff() || isAdmin());
      
      // Technicians can create their own shifts
      allow create: if request.auth != null 
                    && isTechnician()
                    && request.resource.data.technicianId == request.auth.uid;
      
      // Technicians can update their own shifts
      allow update: if request.auth != null 
                    && isTechnician()
                    && resource.data.technicianId == request.auth.uid;
      
      // Staff and admins can update any shift
      allow update: if request.auth != null && (isStaff() || isAdmin());
      
      // Only admins can delete shifts
      allow delete: if request.auth != null && isAdmin();
    }
  }
}